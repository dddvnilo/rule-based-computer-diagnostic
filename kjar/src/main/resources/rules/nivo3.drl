package com.ftn.sbnz.kjar;

import com.ftn.sbnz.model.KvarFakt;
import com.ftn.sbnz.model.KvarFakt.TipKvara;
import com.ftn.sbnz.model.DijagnozaFakt;
import com.ftn.sbnz.model.DijagnozaFakt.Ozbiljnost;
import com.ftn.sbnz.model.SimptomFakt;

// Pravilo 9: Kvar ventilatora -> KRITICNO
rule "Nivo3 - Dijagnoza kvar ventilatora"
    when
        $k : KvarFakt(tipKvara == TipKvara.KVAR_VENTILATORA)
        not DijagnozaFakt(tipKvara == TipKvara.KVAR_VENTILATORA)
    then
        insert(new DijagnozaFakt(
            $k.getKomponenta(),
            TipKvara.KVAR_VENTILATORA,
            Ozbiljnost.KRITICNO,
            "Hitno iskljuciti racunar. Zameniti CPU ventilator."
        ));
        System.out.println("Nivo 3: KRITICNO - kvar ventilatora");
end

// Pravilo 10: Istrosena termalna pasta -> UPOZORENJE
rule "Nivo3 - Dijagnoza istrosena termalna pasta"
    when
        $k : KvarFakt(tipKvara == TipKvara.ISTROSENA_TERMALNA_PASTA)
        not DijagnozaFakt(tipKvara == TipKvara.ISTROSENA_TERMALNA_PASTA)
    then
        insert(new DijagnozaFakt(
            $k.getKomponenta(),
            TipKvara.ISTROSENA_TERMALNA_PASTA,
            Ozbiljnost.UPOZORENJE,
            "Planirati zamenu termalne paste na CPU-u."
        ));
        System.out.println("Nivo 3: UPOZORENJE - istrosena termalna pasta");
end

// Pravilo 11: Pregrevanje GPU -> KRITICNO ako > 100, UPOZORENJE ako > 95
rule "Nivo3 - Dijagnoza pregrevanje GPU kriticno"
    when
        $k : KvarFakt(tipKvara == TipKvara.PREGREVANJE_GPU)
        SimptomFakt(temperaturaGPU > 100)
        not DijagnozaFakt(tipKvara == TipKvara.PREGREVANJE_GPU)
    then
        insert(new DijagnozaFakt(
            $k.getKomponenta(),
            TipKvara.PREGREVANJE_GPU,
            Ozbiljnost.KRITICNO,
            "Odmah iskljuciti racunar. Proveriti GPU ventilator i termopaste."
        ));
        System.out.println("Nivo 3: KRITICNO - pregrevanje GPU");
end

rule "Nivo3 - Dijagnoza pregrevanje GPU upozorenje"
    when
        $k : KvarFakt(tipKvara == TipKvara.PREGREVANJE_GPU)
        SimptomFakt(temperaturaGPU <= 100)
        not DijagnozaFakt(tipKvara == TipKvara.PREGREVANJE_GPU)
    then
        insert(new DijagnozaFakt(
            $k.getKomponenta(),
            TipKvara.PREGREVANJE_GPU,
            Ozbiljnost.UPOZORENJE,
            "Pratiti temperaturu GPU-a. Proveriti ventilaciju."
        ));
        System.out.println("Nivo 3: UPOZORENJE - pregrevanje GPU");
end

// Pravilo 12: Fizicki kvar RAM -> KRITICNO
rule "Nivo3 - Dijagnoza fizicki kvar RAM"
    when
        $k : KvarFakt(tipKvara == TipKvara.FIZICKI_KVAR_RAM)
        not DijagnozaFakt(tipKvara == TipKvara.FIZICKI_KVAR_RAM)
    then
        insert(new DijagnozaFakt(
            $k.getKomponenta(),
            TipKvara.FIZICKI_KVAR_RAM,
            Ozbiljnost.KRITICNO,
            "Zameniti RAM modul. Do tada izbegavati upotrebu racunara."
        ));
        System.out.println("Nivo 3: KRITICNO - fizicki kvar RAM");
end
