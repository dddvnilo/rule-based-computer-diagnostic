template header
atribut
operator
prag
komponenta

package com.ftn.sbnz.kjar;

import com.ftn.sbnz.model.SimptomFakt;
import com.ftn.sbnz.model.KomponentaFakt;
import com.ftn.sbnz.model.KomponentaFakt.TipKomponente;

template "nivo1_numeric"

rule "Nivo1 - @{atribut} @{operator} @{prag} -> @{komponenta}"
    when
        $s : SimptomFakt(@{atribut} @{operator} @{prag})
        not KomponentaFakt(tipKomponente == TipKomponente.@{komponenta})
    then
        insert(new KomponentaFakt(TipKomponente.@{komponenta}));
        System.out.println("Nivo 1 (template): @{atribut} @{operator} @{prag} -> @{komponenta}");
end

end template
