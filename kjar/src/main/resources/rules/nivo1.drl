// === OS ===

rule "Nivo1 - Event log greske"
    when
        $s : SimptomFakt(eventLogGreske > 5)
        not KomponentaFakt(tipKomponente == TipKomponente.OS)
    then
        insert(new KomponentaFakt(TipKomponente.OS));
        System.out.println("Nivo 1: Event log greske - sumnja na OS");
