package com.ftn.sbnz.kjar;

import com.ftn.sbnz.model.SimptomFakt;
import com.ftn.sbnz.model.KomponentaFakt;
import com.ftn.sbnz.model.KomponentaFakt.TipKomponente;

// === CPU / COOLING ===

rule "Nivo1 - Visoka temperatura CPU"
    when
        $s : SimptomFakt(temperaturaCPU > 90)
        not KomponentaFakt(tipKomponente == TipKomponente.COOLING)
    then
        insert(new KomponentaFakt(TipKomponente.COOLING));
        insert(new KomponentaFakt(TipKomponente.CPU));
        System.out.println("Nivo 1: Visoka temperatura CPU - sumnja na COOLING i CPU");
end

rule "Nivo1 - Korisnik prijavljuje pregrevanje"
    when
        $s : SimptomFakt(pregrevanje == true)
        not KomponentaFakt(tipKomponente == TipKomponente.COOLING)
    then
        insert(new KomponentaFakt(TipKomponente.COOLING));
        insert(new KomponentaFakt(TipKomponente.CPU));
        System.out.println("Nivo 1: Korisnik prijavljuje pregrevanje - sumnja na COOLING i CPU");
end

rule "Nivo1 - Neobicni zvukovi"
    when
        $s : SimptomFakt(neobicniZvukovi == true)
        not KomponentaFakt(tipKomponente == TipKomponente.COOLING)
    then
        insert(new KomponentaFakt(TipKomponente.COOLING));
        System.out.println("Nivo 1: Neobicni zvukovi - sumnja na COOLING");
end

// === GPU ===

rule "Nivo1 - Artefakti na ekranu"
    when
        $s : SimptomFakt(artefaktiNaEkranu == true)
        not KomponentaFakt(tipKomponente == TipKomponente.GPU)
    then
        insert(new KomponentaFakt(TipKomponente.GPU));
        System.out.println("Nivo 1: Artefakti na ekranu - sumnja na GPU");
end

rule "Nivo1 - Visoka temperatura GPU"
    when
        $s : SimptomFakt(temperaturaGPU > 90)
        not KomponentaFakt(tipKomponente == TipKomponente.GPU)
    then
        insert(new KomponentaFakt(TipKomponente.GPU));
        System.out.println("Nivo 1: Visoka temperatura GPU - sumnja na GPU");
end

// === RAM ===

rule "Nivo1 - BSOD Memory Management"
    when
        $s : SimptomFakt(bsod == true, bsodKod == "MEMORY_MANAGEMENT")
        not KomponentaFakt(tipKomponente == TipKomponente.RAM)
    then
        insert(new KomponentaFakt(TipKomponente.RAM));
        System.out.println("Nivo 1: BSOD MEMORY_MANAGEMENT - sumnja na RAM");
end

rule "Nivo1 - Zamrzavanje sistema"
    when
        $s : SimptomFakt(zamrzavanje == true)
        not KomponentaFakt(tipKomponente == TipKomponente.RAM)
    then
        insert(new KomponentaFakt(TipKomponente.RAM));
        System.out.println("Nivo 1: Zamrzavanje - sumnja na RAM");
end

// === DISK ===

rule "Nivo1 - SMART reallocated sektori"
    when
        $s : SimptomFakt(smartReallocatedSectors > 0)
        not KomponentaFakt(tipKomponente == TipKomponente.DISK)
    then
        insert(new KomponentaFakt(TipKomponente.DISK));
        System.out.println("Nivo 1: SMART reallocated sektori - sumnja na DISK");
end

rule "Nivo1 - Spor rad sistema"
    when
        $s : SimptomFakt(sporRad == true)
        not KomponentaFakt(tipKomponente == TipKomponente.DISK)
    then
        insert(new KomponentaFakt(TipKomponente.DISK));
        System.out.println("Nivo 1: Spor rad - sumnja na DISK");
end

// === PSU ===

rule "Nivo1 - Nestabilan napon 12V"
    when
        $s : SimptomFakt(napon12V < 11.4)
        not KomponentaFakt(tipKomponente == TipKomponente.PSU)
    then
        insert(new KomponentaFakt(TipKomponente.PSU));
        System.out.println("Nivo 1: Nestabilan napon 12V - sumnja na PSU");
end

rule "Nivo1 - Nestabilan napon 5V"
    when
        $s : SimptomFakt(napon5V < 4.75)
        not KomponentaFakt(tipKomponente == TipKomponente.PSU)
    then
        insert(new KomponentaFakt(TipKomponente.PSU));
        System.out.println("Nivo 1: Nestabilan napon 5V - sumnja na PSU");
end

rule "Nivo1 - Nestabilan napon 3.3V"
    when
        $s : SimptomFakt(napon3V3 < 3.1)
        not KomponentaFakt(tipKomponente == TipKomponente.PSU)
    then
        insert(new KomponentaFakt(TipKomponente.PSU));
        System.out.println("Nivo 1: Nestabilan napon 3.3V - sumnja na PSU");
end

rule "Nivo1 - Ucestali restartovi"
    when
        $s : SimptomFakt(ucestaliRestartovi == true)
        not KomponentaFakt(tipKomponente == TipKomponente.PSU)
    then
        insert(new KomponentaFakt(TipKomponente.PSU));
        insert(new KomponentaFakt(TipKomponente.MOTHERBOARD));
        System.out.println("Nivo 1: Ucestali restartovi - sumnja na PSU i MOTHERBOARD");
end

// === MOTHERBOARD ===

rule "Nivo1 - Visoka temperatura chipseta"
    when
        $s : SimptomFakt(temperaturaChipseta > 85)
        not KomponentaFakt(tipKomponente == TipKomponente.MOTHERBOARD)
    then
        insert(new KomponentaFakt(TipKomponente.MOTHERBOARD));
        System.out.println("Nivo 1: Visoka temperatura chipseta - sumnja na MOTHERBOARD");
end

// === NETWORK ===

rule "Nivo1 - Visok packet loss"
